# ============================================
# Atican Beach Resort - Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# --- Supabase ---
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - NEVER expose to browser. Used only in server routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Paystack ---
# Get these from https://dashboard.paystack.com/#/settings/api
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# --- MafrexPay ---
# Keep the API key server-only. Set enabled=true only after applying the
# MafrexPay booking migration and verifying the configured API client origins.
MAFREXPAY_BASE_URL=https://www.mafrexai.com
MAFREXPAY_API_KEY=mfx_pay_xxxxxxxxxxxxx
MAFREXPAY_ENABLED=false

# MafrexAI Property Sync callback receiver (server-only; never NEXT_PUBLIC_)
MAFREX_SYNC_CALLBACK_SECRET=replace-with-the-callback-secret-from-mafrexai
MAFREX_SYNC_CLIENT_ID=replace-with-the-property-sync-client-uuid

# MafrexAI Property Sync outbound API (server-only; never NEXT_PUBLIC_)
MAFREXAI_PROPERTY_SYNC_KEY=mfx_sync_replace-with-the-full-key
MAFREXAI_PROPERTY_SYNC_BASE_URL=https://www.mafrexai.com
MAFREXAI_PROPERTY_SYNC_SOURCE=atican-website
MAFREXAI_PULL_SYNC_TOKEN=replace-with-a-long-random-server-secret
CRON_SECRET=replace-with-a-long-random-server-secret

# --- Resend (Email) ---
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# --- App ---
# Your app's public URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# --- OpenRouter AI (Receptionist & Concierge) ---
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# --- Google TTS (AI Receptionist Voice) ---
# Get from https://console.cloud.google.com/apis/credentials
# Enable Cloud TTS API and create an API key
NEXT_PUBLIC_GOOGLE_TTS_KEY=your-google-tts-api-key-here
